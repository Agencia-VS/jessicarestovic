# Proyecto de Supabase — Configuración > API en el panel de Supabase.
# Sin prefijo NEXT_PUBLIC_ a propósito: nada del navegador las necesita, así
# que no se hornean en el bundle. La URL se acepta con o sin https://.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# URL pública del sitio (metadatos, sitemap, canónicas y el enlace de
# recuperación de contraseña). Opcional: si se deja vacía o mal escrita, se usa
# https://jessicarestovic.com. No definirla es preferible a definirla vacía.
SITE_URL=https://jessicarestovic.com

# Módulo de contactos y estadísticas. Exclusivamente en el servidor.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto aleatorio para la depuración diaria de Vercel Cron.
CRON_SECRET=
# Solo con una base de pruebas: habilita captación y medición fuera de producción.
# En las previews se desactivan por defecto.
ENABLE_ANALYTICS_TEST=false
