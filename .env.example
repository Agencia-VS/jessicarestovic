# Proyecto de Supabase — Configuración > API en el panel de Supabase.
# La URL se acepta con o sin https://, pero lo correcto es la forma completa.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio (metadatos, sitemap, canónicas y el enlace de
# recuperación de contraseña). Opcional: si se deja vacía o mal escrita, se usa
# https://jessicarestovic.com. No definirla es preferible a definirla vacía.
NEXT_PUBLIC_SITE_URL=https://jessicarestovic.com
